{
  "name": "envpulse",
  "version": "0.1.6",
  "description": "Audit .env drift and secret leaks in your repository - zero dependencies",
  "type": "module",
  "bin": {
    "envpulse": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node --experimental-strip-types src/cli.ts",
    "demo:fixtures": "node scripts/make-demo-app.mjs && node scripts/make-leaky-fixture.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "dotenv",
    "env",
    "secrets",
    "security",
    "drift",
    "lint",
    "cli",
    "devops"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kesheC/envpulse.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "author": "kesheC",
  "bugs": {
    "url": "https://github.com/kesheC/envpulse/issues"
  },
  "homepage": "https://github.com/kesheC/envpulse#readme"
}
