# Normalise line endings on checkout so a Windows clone and a Linux clone of
# this repository produce the same bytes. Without this, every file shows up as
# modified on one of the two.
* text=auto eol=lf

# A shell fixture is a script; let it keep the shebang-mandated LF on every OS.
*.sh text eol=lf

package-lock.json text eol=lf -diff
